---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import ChatBot from '../components/ChatBot.astro';

interface Props {
  brand?: string;
  title?: string;
}
const { brand = "plaza", title = "252 Plaza" } = Astro.props;
---

<html lang="es">
  <head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Lora:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet" />
</head>
  <body data-brand={brand}>
    <Header />
    <slot />
    <Footer />
    <ThemeToggle />
    <ChatBot />
  </body>
</html>

<style is:global>
  @import '../styles/globals.css';
</style>

<style is:global>
  @import '../styles/globals.css';
</style>