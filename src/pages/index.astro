---
import Layout from '../layouts/Layout.astro';
import SubBrandCard from '../components/SubBrandCard.astro';

import imgChelato from '../assets/images/chelato.webp';
import imgPizzeria from '../assets/images/pizza.jpg';
import imgCafeteria from '../assets/images/cafe.webp';
import imgRestaurante from '../assets/images/el-paso.jpg';
---

<Layout brand="plaza" title="252 Plaza · Mercado Gastronómico">

  <!-- HERO -->
<section class="hero">
  <video class="hero__video" autoplay muted loop playsinline>
    <source src="/hero.mp4" type="video/mp4" />
  </video>
  <div class="hero__overlay"></div>
  <div class="hero__contenido">
    <h1 class="hero__titulo">252 Plaza</h1>
    <p class="hero__eslogan">Tu parada obligatoria en Ruta 5</p>
  </div>
</section>

  <!-- CARDS -->
  <section class="marcas">
    <SubBrandCard brand="pizzeria" nombre="Del Tomate" descripcion="Las mejores pizzas artesanales" href="/pizzeria" imagen={imgPizzeria} />
    <SubBrandCard brand="cafeteria" nombre="Modo Café" descripcion="Café de especialidad y más" href="/cafeteria" imagen={imgCafeteria} />
    <SubBrandCard brand="heladeria" nombre="Chelato" descripcion="Helados artesanales únicos" href="/heladeria" imagen={imgChelato} />
    <SubBrandCard brand="restaurante" nombre="El Paso" descripcion="Parador con sabor de campo" href="/restaurante" imagen={imgRestaurante} />
  </section>
<!-- MAPA -->
<section class="mapa">
  <h2 class="mapa__titulo">¿Dónde estamos?</h2>
  <p class="mapa__subtitulo">Ruta 5, Km 252 · Paso de los Toros, Uruguay</p>
  <div class="mapa__contenedor">
    <iframe
      src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3353.900249601076!2d-56.51947734649654!3d-32.794904081402386!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x95a6410033604375%3A0x7b1b3f177bae54aa!2sPlaza%20de%20comidas%20252!5e0!3m2!1ses-419!2suy!4v1777337995837!5m2!1ses-419!2suy"
      width="100%"
      height="450"
      style="border:0;"
      allowfullscreen=""
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
    ></iframe>
  </div>
</section>
</Layout>

<style>
  .hero {
    position: relative;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .hero__video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
    z-index: 1;
  }

  .hero__contenido {
    position: relative;
    z-index: 2;
    text-align: center;
  }

  .hero__titulo {
    color: #FFFFFF;
    font-size: 3.5rem;
    letter-spacing: 6px;
    margin-bottom: 1rem;
  }

  .hero__eslogan {
    color: var(--brand-accent);
    font-size: 1.2rem;
    letter-spacing: 2px;
  }

  .marcas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
    padding: 2rem;
    max-width: 1100px;
    margin: 0 auto;
  }
  .mapa {
    padding: 3rem 2rem;
    max-width: 1100px;
    margin: 0 auto;
    text-align: center;
  }

  .mapa__titulo {
    color: var(--brand-primary);
    font-size: 2rem;
    margin-bottom: 0.5rem;
  }

  .mapa__subtitulo {
    color: var(--brand-accent);
    font-size: 1rem;
    margin-bottom: 1.5rem;
    letter-spacing: 1px;
  }

  .mapa__contenedor {
    border-radius: 12px;
    overflow: hidden;
    border: 2px solid var(--brand-primary);
  }
</style>