---
import Layout from '../layouts/Layout.astro';
import MenuCard from '../components/MenuCard.astro';
import { MENU } from '../config/menu';

import imgDDL from '../assets/images/helado-ddl.webp';
import imgBosque from '../assets/images/helado-bosque.webp';
import imgChocolate from '../assets/images/helado-chocolate.webp';

const imagenes = [imgDDL, imgBosque, imgChocolate];
---

<Layout brand="heladeria" title="Chelato · Heladería">

  <section class="subhero">
    <h1 class="subhero__titulo">Chelato</h1>
    <p class="subhero__subtitulo">Helados artesanales</p>
  </section>

  <section class="menu">
    <h2 class="menu__titulo">Nuestro Menú</h2>
    <div class="menu__grid">
      {MENU.heladeria.map((item, i) => (
        <MenuCard
          nombre={item.nombre}
          descripcion={item.descripcion}
          precio={item.precio}
          imagen={imagenes[i]}
        />
      ))}
    </div>
  </section>

</Layout>

<style>
  .subhero {
    text-align: center;
    padding: 4rem 2rem 2rem;
  }

  .subhero__titulo {
    color: var(--brand-primary);
    font-size: 3rem;
    letter-spacing: 4px;
    margin-bottom: 0.5rem;
  }

  .subhero__subtitulo {
    color: var(--brand-accent);
    font-size: 1rem;
    letter-spacing: 2px;
  }

  .menu {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem;
  }

  .menu__titulo {
    color: var(--brand-text);
    font-size: 1.5rem;
    margin-bottom: 2rem;
    text-align: center;
    opacity: 0.7;
  }

  .menu__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }
</style>